{
  "name": "@dif.sh/sdk",
  "version": "0.8.0",
  "description": "Zero-dependency runtime for dif feature flags and A/B tests. Assigns variants locally by hashing the user ID, and records exposures and metric events.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./script.js": "./dist/script.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "build": "node scripts/gen-version.mjs && tsc -p tsconfig.json && npm run build:script",
    "build:script": "esbuild src/script/index.ts --bundle --format=iife --minify --target=es2017 --outfile=dist/script.js",
    "size": "node scripts/check-script-size.mjs",
    "test": "node --test --import tsx src/*.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run size"
  },
  "engines": {
    "node": ">=20.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dif-sh/dif.git",
    "directory": "cli/packages/sdk"
  },
  "homepage": "https://www.dif.sh/docs/",
  "keywords": [
    "experimentation",
    "ab-testing",
    "feature-flags",
    "analytics",
    "metrics",
    "dif.sh",
    "feature-toggles",
    "feature-management",
    "flags-as-code",
    "typescript"
  ],
  "devDependencies": {
    "esbuild": "0.28.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
