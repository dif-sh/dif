{
  "name": "@dif.sh/cli",
  "version": "0.6.3",
  "description": "The dif CLI: feature flags and A/B tests as Markdown files in your git repo. `dif validate` checks them and `dif build` compiles a typed TypeScript client. This package downloads the matching Rust binary on install.",
  "license": "MIT",
  "bin": {
    "dif": "bin/dif.js"
  },
  "files": [
    "bin",
    "install.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dif-sh/dif.git",
    "directory": "cli/packages/cli"
  },
  "homepage": "https://www.dif.sh/docs/",
  "keywords": [
    "experimentation",
    "ab-testing",
    "feature-flags",
    "dif.sh",
    "cli",
    "feature-toggles",
    "feature-management",
    "flags-as-code",
    "git",
    "gitops",
    "markdown",
    "claude-code",
    "ai-agents"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
