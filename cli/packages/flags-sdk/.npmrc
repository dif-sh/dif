# npm 10's arborist crashes ("Cannot read properties of null (reading 'edgesOut')")
# walking vitest 4 -> vite 8 -> optional peer @vitejs/devtools-vitest -> vitest@*.
# Skipping automatic peer installs avoids that walk. @dif.sh/sdk is also a
# devDependency, so it is still installed. Not needed upstream (pnpm).
legacy-peer-deps=true
