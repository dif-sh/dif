{
  "name": "@dif.sh/flags-sdk",
  "version": "0.6.3",
  "description": "Vercel Flags SDK adapter for dif feature flags and A/B tests. Assigns variants from dif/generated/client.ts.",
  "keywords": [
    "flags-sdk",
    "vercel",
    "dif.sh",
    "feature-flags",
    "ab-testing",
    "experimentation",
    "flags-as-code",
    "feature-toggles",
    "feature-management",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://www.dif.sh/docs/",
  "bugs": {
    "url": "https://github.com/dif-sh/dif/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dif-sh/dif.git",
    "directory": "cli/packages/flags-sdk"
  },
  "license": "MIT",
  "author": "Chris Fowles <chris@dif.sh>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "typesVersions": {
    "*": {
      ".": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch --clean=false",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@dif.sh/sdk": "^0.6.3"
  },
  "devDependencies": {
    "@dif.sh/sdk": "file:../sdk",
    "@types/node": "22.14.0",
    "flags": "^4.3.1",
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}
